# AeroAI - example environment configuration (Section 49).
# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/aatmp
DATABASE_USERNAME=aatmp
DATABASE_PASSWORD=aatmp_dev_password

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# OpenSky (Section 18.3) - credentials-file path takes precedence over
# OPENSKY_CLIENT_ID/OPENSKY_CLIENT_SECRET when explicitly configured.
# The credentials.json file itself lives OUTSIDE this repository and is
# NEVER committed. Without any credentials, the backend still runs at
# OpenSky's reduced anonymous rate limits.
# ---------------------------------------------------------------------------
OPENSKY_CREDENTIALS_FILE=C:\Coding\AATMP\opensky_api_creds\credentials.json
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_OAUTH_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# ---------------------------------------------------------------------------
# FastAPI ML service
# ---------------------------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# JWT (Section 39) - generate a real random secret >= 32 bytes for anything
# beyond local dev, e.g.: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# Ingestion / retention / airspace scheduling (Section 94 config reference)
# ---------------------------------------------------------------------------
OPENSKY_POLL_INTERVAL_SECONDS=15
HISTORY_RETENTION_DAYS=7
TRAIL_RETENTION_MINUTES=60
AIRSPACE_DEFAULT_CITY_ID=mumbai
AIRSPACE_MAX_ACTIVE_CITY_COUNT=1
AIRSPACE_REQUEST_CACHE_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# CORS - comma-separated list of allowed frontend origins (never a wildcard)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend-only public configuration (safe to expose - Vite bundles these
# into public JS). Never put a secret in a VITE_* variable.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
